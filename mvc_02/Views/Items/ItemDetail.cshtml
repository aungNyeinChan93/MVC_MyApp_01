@using mvc_02.Models

@model Item

@{
    // ViewData["Title"] = "Detail Item";
}

<div class="mx-auto container">
    <div class="card" style="width: 18rem;">
        <ul class="list-group list-group-flush">
            <li class="list-group-item">@Model.Name</li>
            <li class="list-group-item">@Model.Category!.Name</li>
            <li class="list-group-item">@Model.Price</li>
        </ul>
        <div class=" d-flex justify-content-between">

            <a href="/items/edit/@Model.ItemId" class="btn btn-warning p-2 my-2 mx-4 w-100">Edit</a>
            <a href="/items" class="btn btn-primary p-2 my-2 mx-4 w-100 ">Back</a>

        </div>
    </div>
</div>